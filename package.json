{
  "name": "nudle-school-management",
  "version": "0.0.0",
  "private": true,
  "description": "Nudle School Management Application",
  "license": "UNLICENSED",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "e2e": "playwright test --ui --config src/test/webapp/e2e/playwright.config.ts",
    "e2e:headless": "playwright test --config src/test/webapp/e2e/playwright.config.ts",
    "dev": "npm-run-all --parallel dev:*",
    "dev:vite": "vite",
    "build": "npm-run-all build:*",
    "build:tsc": "tsc -b",
    "build:vite": "vite build --emptyOutDir",
    "preview": "vite preview",
    "start": "vite",
    "lint": "eslint .",
    "test": "npm run watch:test",
    "test:coverage": "vitest run --coverage",
    "watch": "npm-run-all --parallel watch:*",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:test": "vitest --",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@tsconfig/vite-react": "7.0.2",
    "@vitejs/plugin-react": "6.0.3",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "29.1.1",
    "vite": "8.1.3",
    "typescript": "5.9.3",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "@vitest/coverage-istanbul": "4.1.9",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "@eslint/js": "9.39.4",
    "globals": "17.7.0",
    "npm-run-all2": "9.0.2",
    "typescript-eslint": "8.58.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.9",
    "vitest-sonar-reporter": "3.0.0",
    "@prettier/plugin-xml": "3.4.2",
    "prettier": "3.9.4",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8"
  },
  "type": "module",
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "piqure": "2.2.1"
  }
}
